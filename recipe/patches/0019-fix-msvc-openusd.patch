-  TARGETS usd_decoder_plugin
-  LIBRARY DESTINATION "${CMAKE_INSTALL_BINDIR}/mujoco_plugin"
-)
+if(WIN32)
+  install(
+    TARGETS usd_decoder_plugin
+    ARCHIVE DESTINATION "$ENV{TEMP}"
+    LIBRARY DESTINATION "$ENV{TEMP}"
+    RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}/mujoco_plugin"
+  )
+else()
+  install(
+    TARGETS usd_decoder_plugin
+    LIBRARY DESTINATION "${CMAKE_INSTALL_BINDIR}/mujoco_plugin"
+  )
+endif()
 
